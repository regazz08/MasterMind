<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#6dc0f7"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <!-- LOGO -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="10dp"
        android:contentDescription="Logo"
        android:src="@drawable/mastermindcerchio" />

    <!-- PUNTEGGIO -->
    <TextView
        android:id="@+id/txtRisultato"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="Punteggio: 0"
        android:textColor="@color/black"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- TESTO DOMANDA (Dinamico) -->
    <TextView
        android:id="@+id/txtDomanda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="Caricamento domanda..."
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textAlignment="center"/>

    <!-- UNICO GRUPPO RISPOSTE (Cambia i testi via codice) -->
    <RadioGroup
        android:id="@+id/gruppoRisposte"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">

        <RadioButton
            android:id="@+id/D1R1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="#FFFFFF"
            android:button="@null"
            android:padding="15dp"
            android:text="Opzione 1"
            android:textAlignment="center"
            android:textColor="@color/black" />

        <RadioButton
            android:id="@+id/D1R2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="#FFFFFF"
            android:button="@null"
            android:padding="15dp"
            android:text="Opzione 2"
            android:textAlignment="center"
            android:textColor="@color/black" />

        <RadioButton
            android:id="@+id/D1R3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="#FFFFFF"
            android:button="@null"
            android:padding="15dp"
            android:text="Opzione 3"
            android:textAlignment="center"
            android:textColor="@color/black" />

        <RadioButton
            android:id="@+id/D1R4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="#FFFFFF"
            android:button="@null"
            android:padding="15dp"
            android:text="Opzione 4"
            android:textAlignment="center"
            android:textColor="@color/black" />
    </RadioGroup>

    <!-- PULSANTI DI CONTROLLO (In linea orizzontale) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/btnAvanti"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="15dp"
            android:backgroundTint="#FFFFFF"
            android:paddingLeft="30dp"
            android:paddingRight="30dp"
            android:text="AVANTI"
            android:textColor="#000000"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnInvia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#FFD700"
            android:paddingLeft="40dp"
            android:paddingRight="40dp"
            android:text="INVIA"
            android:textColor="#000000"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>